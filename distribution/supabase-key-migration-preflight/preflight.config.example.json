{
  "projectUrl": "https://YOUR_PROJECT_REF.supabase.co",
  "publishableKeyEnv": "SUPABASE_PUBLISHABLE_KEY",
  "secretKeyEnv": "SUPABASE_SECRET_KEY",
  "timeoutMs": 10000,
  "probes": [
    {
      "id": "auth-settings-publishable",
      "method": "GET",
      "path": "/auth/v1/settings",
      "keyType": "publishable",
      "authStyle": "apikey",
      "expectedStatuses": [200]
    },
    {
      "id": "auth-admin-list-secret-apikey-only",
      "method": "GET",
      "path": "/auth/v1/admin/users?page=1&per_page=1",
      "keyType": "secret",
      "authStyle": "apikey",
      "expectedStatuses": [200]
    },
    {
      "id": "rest-openapi-publishable",
      "method": "HEAD",
      "path": "/rest/v1/",
      "keyType": "publishable",
      "authStyle": "apikey",
      "expectedStatuses": [200]
    },
    {
      "id": "rest-openapi-secret",
      "method": "HEAD",
      "path": "/rest/v1/",
      "keyType": "secret",
      "authStyle": "apikey",
      "expectedStatuses": [200]
    }
  ]
}
